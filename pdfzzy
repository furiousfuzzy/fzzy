            wait(1)
        end
    end)


    ----------------------------------------------------------------------
    -- Rendering
    ----------------------------------------------------------------------
    local lastT = tick()
    local pillX, pillL, pillW = {}, {}, {}

    local function hpColor(f)
        if f > 0.5 then return mixc(HP_YELLOW, HP_GREEN, (f - 0.5) * 2) end
        return mixc(HP_RED, HP_YELLOW, f * 2)
    end

    local function fmtPlaytime(s)
        if type(s) ~= "number" then return "?" end
        return memoFmt(FM_PT, "%.1fh", floor(s / 36 + 0.5) / 100)
    end

    local EMPTY, KD_LABELS, KVALS = {}, { "KDR", "KILLS", "DEATHS" }, { "?", "?", "?" }
    local function renderInfo(now, dt)
        local perfMode = OPT.perf
        local goal = P.want and 1 or 0
        if perfMode then
            P.alpha = goal
        else
            P.alpha = P.alpha + (goal - P.alpha) * (1 - exp(-14 * dt))
            if abs(P.alpha - goal) < 0.01 then P.alpha = goal end
        end
        if P.alpha < 0.01 or not D.name then return end

        local f = FIELDS
        local w = PANEL_W
        local cam = Workspace.CurrentCamera
        local vs = cam and cam.ViewportSize

        -- dragging by the top bar
        local mx, my = Mouse.X, Mouse.Y
        local down = ismouse1pressed() and isrbxactive()
        if down and Window.open and not P.wasDown and P.alpha > 0.5 then
            if mx >= P.x and mx <= P.x + w and my >= P.y and my <= P.y + HEADER_H then
                P.drag = { mx - P.x, my - P.y }
            end
        end
        if P.drag then
            if down then P.x, P.y = mx - P.drag[1], my - P.drag[2] else P.drag = nil; FZPOS.put("info", P.x, P.y) end
        end
        P.wasDown = down
        if vs then
            P.x = clamp(P.x, 0, max(0, vs.X - w))
            P.y = clamp(P.y, 0, max(0, vs.Y - P.h))
        end

        -- layout pass: total height
        local rows = 0
        if f.Playtime then rows = rows + 1 end
        if f.Reports then rows = rows + 1 end
        if f.Speed then rows = rows + 1 end
        if f.Team then rows = rows + 1 end
        if f.Holding then rows = rows + 1 end
        local hotLines = D.hotLines or EMPTY
        local stimLines = 1
        if f.Stims then
            local cx = 14
            for i = 1, D.stimN do
                local s = STIMS[D.stimIdx[i]]
                local pw = floor(textWidth(s.label, 10) * 1.1 + 26)
                if cx + pw > w - 14 and cx > 14 then stimLines = stimLines + 1; cx = 14 end
                pillX[i], pillL[i], pillW[i] = cx, stimLines, pw
                cx = cx + pw + 5
            end
        end
        local h = HEADER_H
        if f.Health then h = h + 34 end
        if f.KDR then h = h + 50 end
        h = h + rows * 20
        if f.Stims then h = h + 20 + stimLines * 22 end
        if f.Hotbar then h = h + 24 + max(1, #hotLines) * 16 end
        h = h + 10
        P.h = h

        local op = OPT.piOp
        local A = P.alpha
        local bgA = A * op
        local fgA = A * min(1, op + 0.08)
        local x, y = P.x, P.y

        local cBg, cGroup, cBorder = tc("bg"), tc("group"), tc("border")
        local cText, cDim, cAccent = tc("text"), tc("dim"), tc("accent")
        local track = mixc(cGroup, cText, 0.15)

        -- soft shadow + body
        if OPT.piShadow and not perfMode then
            for i = 3, 1, -1 do
                drawRect(K("sh", i),x - i * 2, y - i * 2 + 4, w + i * 4, h + i * 4, BLACK, 0.05 * bgA, 99, true, 10 + i * 2)
            end
        end
        drawRect("bd", x, y, w, h, cBorder, bgA, 100, true, 10)
        drawRect("bg", x + 1, y + 1, w - 2, h - 2, cBg, bgA, 101, true, 9)

        -- header: headshot (initial badge until it loads), name, distance pill
        local name = D.name
        drawCirc("av", x + 27, y + 24, 14, mixc(cGroup, cAccent, 0.3), fgA, 102, true)
        local av = D.uid and AV[D.uid]
        if D.uid then requestAvatar(D.uid) end
        if av and av.state == "ok" then
            drawImg("avi", av.data, x + 13, y + 10, 28, fgA, 103, 14)
        else
            drawTxt("avt", string.upper(name:sub(1, 1)), x + 27, y + 24, cText, fgA, 104, 13, true, "c")
        end
        drawCirc("avr", x + 27, y + 24, 14.5, mixc(cGroup, cAccent, 0.75), fgA, 105, false, 1.2)
        local pillSpace = 0
        if f.Distance and D.dist then
            local ds = memoFmt(FM_DIST, "%s m", D.dist)
            local pw = textWidth(ds, 11) + 18
            pillSpace = pw + 8
            drawRect("dp", x + w - 12 - pw, y + 13, pw, 20, cGroup, fgA, 102, true, 7)
            drawRect("dpb", x + w - 12 - pw, y + 13, pw, 20, mixc(cBorder, cAccent, 0.5), fgA, 103, false, 7, 1)
            drawTxt("dpt", ds, x + w - 12 - pw / 2, y + 23, cAccent, fgA, 104, 11, true, "c")
        end
        drawTxt("nm", fitText(name, w - 56 - pillSpace - 12, 14), x + 48, y + 24, cText, fgA, 104, 14, true)
        drawRect("hs", x + 12, y + HEADER_H - 3, w - 24, 1, cBorder, fgA, 103, true, 0)

        local cy = y + HEADER_H

        -- health bar
        if f.Health then
            drawTxt("hl", "HEALTH", x + 14, cy + 8, cDim, fgA, 104, 10, true)
            local hp, mhp = D.hp, D.mhp
            local frac = (hp and mhp and mhp > 0) and clamp(hp / mhp, 0, 1) or 0
            P.hp = P.hp + (frac - P.hp) * (perfMode and 1 or (1 - exp(-12 * dt)))
            local hpTxt = "?"
            if hp then
                local hpR, mR = floor(hp + 0.5), floor((mhp or 0) + 0.5)
                if FM_HP.a ~= hpR or FM_HP.b ~= mR then FM_HP.a, FM_HP.b = hpR, mR; FM_HP.s = hpR .. " / " .. mR end
                hpTxt = FM_HP.s
            end
            drawTxt("hv", hpTxt,x + w - 14, cy + 8, cText, fgA, 104, 11, true, "r")
            drawRect("ht", x + 14, cy + 18, w - 28, 8, track, fgA, 102, true, 4)
            drawRect("hf", x + 14, cy + 18, (w - 28) * P.hp, 8, hpColor(P.hp), fgA, 103, true, 4)
            cy = cy + 34
        end

        -- KDR tiles
        if f.KDR then
            local tw3 = (w - 28 - 12) / 3
            local values = KVALS                       -- reused table, no per-frame allocation
            if D.kills then
                values[1] = memoFmt(FM_KD, "%.2f", D.kills / max(D.deaths or 0, 1))
                values[2] = memoFmt(FM_K, "%d", floor(D.kills))
            else
                values[1], values[2] = "?", "?"
            end
            values[3] = D.deaths and memoFmt(FM_D, "%d", floor(D.deaths)) or "?"
            for i = 1, 3 do
                local tx = x + 14 + (i - 1) * (tw3 + 6)
                drawRect(K("tb", i), tx, cy + 4, tw3, 42, cGroup, fgA, 102, true, 7)
                drawRect(K("tbb", i), tx, cy + 4, tw3, 42, mixc(cBorder, cAccent, i == 1 and 0.45 or 0), fgA, 103, false, 7, 1)
                drawTxt(K("tl", i), KD_LABELS[i], tx + tw3 / 2, cy + 15, cDim, fgA, 104, 9.5, true, "c")
                drawTxt(K("tv", i), values[i], tx + tw3 / 2, cy + 32, i == 1 and cAccent or cText, fgA, 104, 15, true, "c")
            end
            cy = cy + 50
        end

        -- label / value rows
        local function infoRow(key, label, value)
            drawTxt(K(key, "l"), label, x + 14, cy + 10, cDim, fgA, 104, 12, false)
            drawTxt(K(key, "v"), fitText(value, w - 110, 12), x + w - 14, cy + 10, cText, fgA, 104, 12, true, "r")
            cy = cy + 20
        end
        if f.Playtime then infoRow("pt", "Playtime", fmtPlaytime(D.played)) end
        if f.Reports then infoRow("rp", "Reports", D.reports and memoFmt(FM_RP, "%d", floor(D.reports)) or "?") end
        if f.Speed then infoRow("sp", "Speed", memoFmt(FM_SP, "%.1f studs/s", floor(D.sp * 10 + 0.5) / 10)) end
        if f.Team then infoRow("tm", "Team", D.team or (TM.snap and "None" or "Loading...")) end
        if f.Holding then infoRow("hd", "Holding", D.held or "Nothing") end

        -- stims
        if f.Stims then
            drawTxt("sl", "STIMS", x + 14, cy + 8, cDim, fgA, 104, 10, true)
            if D.stimN == 0 then
                drawTxt("sn", "None", x + 14, cy + 29, cDim, fgA, 104, 12, false)
            else
                for i = 1, D.stimN do
                    local s = STIMS[D.stimIdx[i]]
                    local px, py = x + pillX[i], cy + 18 + (pillL[i] - 1) * 22
                    drawRect(K("sp", i), px, py, pillW[i], 18, cGroup, fgA, 102, true, 9)
                    drawRect(K("spb", i), px, py, pillW[i], 18, mixc(cBorder, s.col, 0.6), fgA, 103, false, 9, 1)
                    drawCirc(K("spd", i), px + 10, py + 9, 3.5, s.col, fgA, 104, true)
                    drawTxt(K("spt", i), s.label, px + 18, py + 9, cText, fgA, 104, 10, true)
                end
            end
            cy = cy + 20 + stimLines * 22
        end

        -- hotbar items (text list; the held item is on the Holding row)
        if f.Hotbar then
            drawTxt("hbl", "HOTBAR", x + 14, cy + 8, cDim, fgA, 104, 10, true)
            if #hotLines == 0 then
                drawTxt("ihl1", "Empty", x + 14, cy + 28, cDim, fgA, 104, 11, false)
            else
                for i = 1, #hotLines do
                    drawTxt(K("ihl", i), hotLines[i], x + 14, cy + 28 + (i - 1) * 16, cText, fgA, 104, 11, false)
                end
            end
        end

    end

    ----------------------------------------------------------------------
    -- Hotbar panel: name pill (with stim icons), hotbar item tiles, equipment tiles; drag it by the pill
    ----------------------------------------------------------------------
    local function shortName(n)
        if #n > 9 then return string.sub(n, 1, 7) .. ".." end
        return n
    end

    local RK_HOT = { b = "htb", s = "hts", i = "hti", l = "htl", u = "htu", v = "htv" }
    local RK_EQ  = { b = "eqb", s = "eqs", i = "eqi", l = "eql", u = "equ", v = "eqv" }
    local function renderHot(now, dt)
        local perfMode = OPT.perf
        local goal = HB.want and 1 or 0
        if perfMode then
            HB.alpha = goal
        else
            HB.alpha = HB.alpha + (goal - HB.alpha) * (1 - exp(-14 * dt))
            if abs(HB.alpha - goal) < 0.01 then HB.alpha = goal end
        end
        local t = HD
        if HB.alpha < 0.01 or not t.name then return end

        local TILE = OPT.hbTile
        local GAP, PAD, PILL_H, SUB = 6, 4, 26, 18
        local iconsOn = OPT.icons
        local hn = OPT.items and t.hotN or 0
        local showGear = OPT.gear
        local en = showGear and t.eqN or 0
        local sn = OPT.stims and t.stimN or 0
        local msg = nil
        if showGear and en == 0 then msg = (t.eqFound == false) and "Inventory not found" or "No equipment found" end

        local title = fitText(t.name, 170, 12)
        local textW = textWidth(title, 12)
        local pillW = floor(textW + 36 + (sn > 0 and (sn * 19 + 4) or 0))
        local W = max(pillW, hn > 0 and (hn * TILE + (hn - 1) * GAP) or 0, en > 0 and (en * TILE + (en - 1) * GAP) or 0,
            msg and (textWidth(msg, 12) + 28) or 0)
        W = floor(W)
        local H = PILL_H
        if hn > 0 then H = H + 8 + TILE end
        if en > 0 then H = H + 8 + TILE elseif msg then H = H + 8 + 24 end

        local cam = Workspace.CurrentCamera
        local vs = cam and cam.ViewportSize or Vector2.new(1920, 1080)
        if not HB.cx then HB.cx = floor(vs.X / 2) end

        -- dragging by the name pill (the panel keeps its centre when its width changes)
        local mx, my = Mouse.X, Mouse.Y
        local down = ismouse1pressed() and isrbxactive()
        local px0 = floor(HB.cx - W / 2) + floor((W - pillW) / 2)
        if down and Window.open and not HB.wasDown and HB.alpha > 0.5 and mx >= px0 and mx <= px0 + pillW and my >= HB.y and my <= HB.y + PILL_H then
            HB.drag = { mx - HB.cx, my - HB.y }
        end
        if HB.drag then
            if down then HB.cx, HB.y = mx - HB.drag[1], my - HB.drag[2] else HB.drag = nil; FZPOS.put("hot", HB.cx, HB.y) end
        end
        HB.wasDown = down
        HB.cx = clamp(HB.cx, W / 2, max(W / 2, vs.X - W / 2))
        HB.y = clamp(HB.y, 0, max(0, vs.Y - H))

        local left, top = floor(HB.cx - W / 2), floor(HB.y)
        local op = OPT.hbOp
        local A = HB.alpha
        local bgA, fgA = A * op, A * min(1, op + 0.08)
        local cBg, cGroup, cBorder = tc("bg"), tc("group"), tc("border")
        local cText, cDim, cAccent = tc("text"), tc("dim"), tc("accent")

        -- name pill
        px0 = left + floor((W - pillW) / 2)
        drawRect("hpb", px0, top, pillW, PILL_H, mixc(cBorder, cAccent, 0.3), bgA, 100, true, PILL_H / 2)
        drawRect("hpf", px0 + 1, top + 1, pillW - 2, PILL_H - 2, cBg, bgA, 101, true, PILL_H / 2)
        drawTxt("hpt", title, px0 + 18 + textW / 2, top + PILL_H / 2, cText, fgA, 104, 12, true, "c")
        for k = 1, sn do
            local s = STIMS[t.stimIdx[k]]
            local ix = px0 + 18 + textW + 6 + (k - 1) * 19
            local iy = top + (PILL_H - 16) / 2
            local data = iconsOn and IMG.data[s.name]
            if data then
                drawImg(K("hst", k), data, ix, iy, 16, fgA, 104, 0)
            else
                drawCirc(K("hstd", k), ix + 8, iy + 8, 4, s.col, fgA, 104, true)    -- coloured dot until the icon arrives
            end
        end

        local cy = top + PILL_H + 8
        local function row(rk, list, n, isEquipRow)
            local x0 = left + floor((W - (n * TILE + (n - 1) * GAP)) / 2)
            for i = 1, n do
                local it = list[i]
                local x = x0 + (i - 1) * (TILE + GAP)
                local eq = it.eq
                if isEquipRow then eq = (t.held ~= nil and it.item == t.held) end
                local bg = HIGHLIGHT[it.item] and mixc(cGroup, HL_COL, 0.22) or cGroup
                drawRect(K(rk.b, i), x, cy, TILE, TILE, bg, bgA, 102, true, 8)
                drawRect(K(rk.s, i), x, cy, TILE, TILE, eq and cAccent or mixc(cBorder, cAccent, 0.12), fgA, 103, false, 8, eq and 3 or 1.5)
                local data = iconsOn and IMG.data[it.item]
                if data then
                    drawImg(K(rk.i, i), data, x + PAD, cy + PAD, TILE - PAD * 2, fgA, 104, 0)
                else
                    drawTxt(K(rk.l, i), shortName(it.item), x + TILE / 2, cy + TILE / 2, cDim, fgA, 104, 10, true, "c")
                end
                local subs = it.subs
                if subs then
                    local shownSubs = 0
                    for k = 1, #subs do
                        local sd = iconsOn and IMG.data[subs[k]]
                        if sd and shownSubs < 4 then
                            shownSubs = shownSubs + 1
                            local col, r = floor((shownSubs - 1) / 3), (shownSubs - 1) % 3
                            local bx = x + TILE - (SUB + 2) - 2 - col * (SUB + 3)
                            local by = cy + TILE - (SUB + 2) - 2 - r * (SUB + 3)
                            drawRect(K(rk.u, i, shownSubs), bx, by, SUB + 2, SUB + 2, cBg, bgA, 105, true, 4)
                            drawImg(K(rk.v, i, shownSubs), sd, bx + 1, by + 1, SUB, fgA, 106, 0)
                        end
                    end
                end
            end
            cy = cy + TILE + 8
        end
        if hn > 0 then row(RK_HOT, t.hot, hn, false) end
        if en > 0 then
            row(RK_EQ, t.eq, en, true)
        elseif msg then
            local mw = floor(textWidth(msg, 12) + 28)
            local mxx = left + floor((W - mw) / 2)
            drawRect("mb", mxx, cy, mw, 24, cGroup, bgA, 102, true, 8)
            drawRect("ms", mxx, cy, mw, 24, mixc(cBorder, cAccent, 0.12), fgA, 103, false, 8, 1)
            drawTxt("mt", msg, mxx + mw / 2, cy + 12, cDim, fgA, 104, 12, false, "c")
        end
    end

    local cleaned = true
    local function render()
        local now = tick()
        local dt = clamp(now - lastT, 0.001, 0.05)
        lastT = now
        -- nothing wanted and both panels fully faded: one final sweep to hide everything, then do no work at all
        if not P.want and not HB.want and not FZESP.active() and P.alpha < 0.01 and HB.alpha < 0.01 then
            if not cleaned then frame = frame + 1; sweep(); cleaned = true end
            return
        end
        cleaned = false
        frame = frame + 1
        FZP.rec("frame time", dt * 1000)
        local ok1, err1 = FZP.tp("render: info", renderInfo, now, dt)
        local ok2, err2 = FZP.tp("render: hotbar", renderHot, now, dt)
        local ok3, err3, ok4, err4 = true, nil, true, nil
        FZP.tp("render: item esp", FZESP.render, now, dt)
        local ts = tick()
        sweep()
        FZP.rec("render: sweep", (tick() - ts) * 1000)                                   -- one sweep after both panels: anything not drawn this frame is hidden
        local err = (not ok1 and err1) or (not ok2 and err2) or (not ok3 and err3) or (not ok4 and err4) or nil
        if err and err ~= lastErr then lastErr = err; warn("[fzzr player info] " .. tostring(err)) end
        FZP.rec("render total", (tick() - now) * 1000)
        renderMs = renderMs + ((tick() - now) * 1000 - renderMs) * 0.1
    end

    -- lines for the library's Common > Debug page (only exists with the newer core; ignored otherwise)
    if Window.DebugStat then
        Window:DebugStat("Panels render", function()
            return string.format("%.2f ms  |  step %.2f ms", renderMs, stepMs)
        end)
        Window:DebugStat("Step parts (ms)", function()
            local t = FZT or {}
            return string.format("look %.2f | info %.2f | hotbar %.2f | inventory %.2f", t.look or 0, t.info or 0, t.hot or 0, t.inv or 0)
        end)
        Window:DebugStat("Panel drawings", function()
            local shownN = 0
            for i = 1, poolN do if poolList[i].shown then shownN = shownN + 1 end end
            return shownN .. " visible / " .. poolN
        end)
        Window:DebugStat("Icons", function()
            local have, pending = 0, #IMG.queue
            for _ in pairs(IMG.data) do have = have + 1 end
            return have .. " loaded, " .. pending .. " queued"
        end)
        Window:DebugStat("Avatars cached", function()
            local n = 0
            for _ in pairs(AV) do n = n + 1 end
            return tostring(n)
        end)
        Window:DebugStat("Panels active", function()
            local iv, sl = FZINV.s and FZINV.s.want, FZSLF.s and FZSLF.s.want
            return (P.want and "Info " or "") .. (HB.want and "Hotbar " or "") .. (iv and "Inventory " or "") .. (sl and "SLF" or "")
                .. ((not P.want and not HB.want and not iv and not sl) and "idle" or "")
        end)
    end

    local conn = RunService.RenderStepped:Connect(render)

    resetPanelPos = function() P.x, P.y = 20, 20; FZPOS.put("info", 20, 20) end
    resetHotPos = function() HB.cx, HB.y = nil, 44; Window:PosPut("hot", nil) end

    -- prints what the hotbar sees and why an icon is (not) loading
    iconDebug = function()
        task.spawn(function()
            local t = HD
            print("[Hotbar debug] target: " .. tostring(t.name) .. " | icons on: " .. tostring(Window:Get("hb_icons"))
                .. " | hotbar items: " .. t.hotN .. " | equipment: " .. t.eqN .. " | stims: " .. t.stimN
                .. " | held: " .. tostring(t.held))
            print("[Hotbar debug] icon source: " .. IMG_BASES[1] .. "<Item>.png")
            local function line(label, item)
                print("[Hotbar debug] " .. label .. ": " .. item .. " | icon: " .. tostring(IMG.state[item])
                    .. " | " .. tostring(IMG.info[item]))
            end
            for i = 1, t.hotN do line("hotbar " .. i, t.hot[i].item) end
            for i = 1, t.eqN do line("gear " .. i, t.eq[i].item) end
            for i = 1, t.stimN do line("stim " .. i, STIMS[t.stimIdx[i]].name) end
            local pending = #IMG.queue
            print("[Hotbar debug] queued downloads: " .. pending .. " | done")
        end)
    end


    -- full scan of the current target (or yourself): the player object, its ReplicatedStorage data tree, character and loot
    FZDUMPALL = function()
        task.spawn(function()
            local name = (D.name) or LOCAL_NAME
            local out, nodes = {}, 0
            local function add(s) out[#out + 1] = s end
            local function attrs(inst)
                local ok, a = pcall(function() return inst:GetAttributes() end)
                if not ok or type(a) ~= "table" then return "" end
                local p = {}
                for k, v in pairs(a) do p[#p + 1] = tostring(k) .. "=" .. tostring(v) end
                table.sort(p)
                return #p > 0 and ("  [" .. table.concat(p, ", ") .. "]") or ""
            end
            local function walk(inst, depth, maxd)
                if nodes >= 1500 then return end
                nodes = nodes + 1
                local val = ""
                local okv, v = pcall(function() return inst.Value end)
                if okv and v ~= nil then val = " = " .. tostring(v) end
                add(string.rep("  ", depth) .. inst.Name .. " <" .. inst.ClassName .. ">" .. val .. attrs(inst))
                if depth < maxd then
                    local ok, kids = pcall(function() return inst:GetChildren() end)
                    if ok then for i = 1, #kids do walk(kids[i], depth + 1, maxd) end end
                    if nodes % 40 == 0 then task.wait() end
                end
            end
            add("fzzr dump | target: " .. tostring(name))
            local plr = Players:FindFirstChild(name)
            add("== Player object ==")
            if plr then
                add(plr.Name .. " <" .. plr.ClassName .. ">" .. attrs(plr))
                local ch = plr.Character
                add("== Character ==")
                if ch then walk(ch, 0, 2) else add("(none)") end
            else add("(not in Players)") end
            local folder = getPlayersFolder()
            local data = folder and folder:FindFirstChild(name)
            add("== ReplicatedStorage.Players." .. tostring(name) .. " ==")
            if data then walk(data, 0, 7) else add("(not found)") end
            add("== Players in server ==")
            for _, p in ipairs(playerList()) do add(p.Name .. attrs(p)) end
            add("== end (" .. nodes .. " nodes" .. (nodes >= 1500 and ", capped" or "") .. ") ==")
            local text = table.concat(out, "\n")
            for i = 1, #out do print("[dump] " .. out[i]); if i % 60 == 0 then task.wait() end end
            pcall(function() setclipboard(text) end)
            pcall(function() writefile("fzzr_dump.txt", text) end)
            print("[dump] done: copied to clipboard and saved as fzzr_dump.txt (" .. #out .. " lines)")
            pcall(function() Window:Toast({ Title = "Dump finished", Text = #out .. " lines copied", Icon = "info", Duration = 3 }) end)
        end)
    end

    -- prints every attribute the game stores for the current target, so the key lists at the top can be fixed
    dumpPlayerStats = function()
        task.spawn(function()
            local t = (D.name and D) or newData(LOCAL_NAME)
            resolve(t)
            local function dump(label, inst)
                if not inst then print("[PlayerInfo dump] " .. label .. ": not found"); return end
                local parts = {}
                local ok, names = pcall(function() return inst:GetAttributes() end)
                if ok and type(names) == "table" then
                    for k, v in pairs(names) do
                        if type(k) == "number" then
                            local okg, val = pcall(function() return inst:GetAttribute(v) end)
                            parts[#parts + 1] = tostring(v) .. "=" .. (okg and tostring(val) or "?")
                        else
                            parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
                        end
                    end
                end
                print("[PlayerInfo dump] " .. label .. " (" .. #parts .. " attributes): " .. table.concat(parts, ", "))
            end
            print("[PlayerInfo dump] target: " .. tostring(t.name))
            dump("Statistics", t.stat)
            dump("WipeStatistics", t.wipe)
            dump("GameplayVariables", t.gv)
            dump("Buffs", t.buffs)
            dump("UAC.Reports", t.rep)
            local plr = Players:FindFirstChild(t.name)
            local ch = plr and plr.Character
            local ok, hum = pcall(function() return ch and ch:FindFirstChildOfClass("Humanoid") end)
            if ok and hum then
                local ok2, h, m = pcall(function() return hum.Health, hum.MaxHealth end)
                print("[PlayerInfo dump] Humanoid Health/MaxHealth: " .. tostring(ok2 and h) .. " / " .. tostring(ok2 and m))
            else
                print("[PlayerInfo dump] no Humanoid found")
            end
            print("[PlayerInfo dump] done")
        end)
    end

    _G.__FzzrPlayerInfo = function()
        running = false
        pcall(function() conn:Disconnect() end)
        for _, d in pairs(pool) do pcall(function() d.o:Remove() end) end
        pool = {}
    end
end

