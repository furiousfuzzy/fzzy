--========================================================================
-- Single-instance guard: a second launch while this one is running is cancelled, so two copies never overlap.
-- To replace a running copy on purpose (e.g. after editing), run  _G.FzzrReload = true  before executing again.
-- "Running" means a heartbeat was seen in the last 3 seconds, so a crashed copy never blocks a new launch.
--========================================================================
local SESSION = {}
local Window                                   -- assigned below; the heartbeat loop reads it
do
    local hub = _G.__FzzrHub
    local alive = false
    if hub and not hub.dead and hub.lastFrame then             -- core exports a heartbeat (see the core patch)
        alive = tick() - hub.lastFrame < 3
    elseif _G.__FzzrSession and _G.__FzzrAlive then            -- otherwise this script's own heartbeat
        alive = tick() - _G.__FzzrAlive < 3
    end
    if alive and not _G.FzzrReload then
        warn("[fzzr] already running - this launch was cancelled (set _G.FzzrReload = true before running to replace it)")
        pcall(function() hub:Toast({ Title = "Already running", Text = "Second launch cancelled", Icon = "info", Duration = 3 }) end)
        return
    end
    _G.FzzrReload = nil
    if _G.__FzzrPlayerInfo then pcall(_G.__FzzrPlayerInfo); _G.__FzzrPlayerInfo = nil end   -- remove the old panels first
    _G.__FzzrSession = SESSION
    local launchedAt = tick()
    task.spawn(function()
        while _G.__FzzrSession == SESSION do
            if Window and Window.dead then break end                   -- the window was destroyed: stop the heartbeat
            if not Window and tick() - launchedAt > 45 then break end  -- never got as far as creating the window
            _G.__FzzrAlive = tick()
            wait(0.5)
        end
    end)
end

