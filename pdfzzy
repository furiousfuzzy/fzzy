        t.deaths = attrSum(t.stat, dk) or attrSum(t.wipe, dk) or attrNum(t.stat, DEATH_KEYS) or attrNum(t.wipe, DEATH_KEYS)
        t.played = attrNum(t.stat, { "TimePlayed" }) or attrNum(t.wipe, { "TimePlayed" })
