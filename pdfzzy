local Fzzr = _G.Fzzr                  -- Matcha drops loadstring return values, so the library lives in _G.Fzzr

local Window = Fzzr:CreateWindow({
    Title = "fzzr", Version = "1.0.0", Position = { 60, 40 },
    -- LogoUrl = "https://raw.githubusercontent.com/zwooshii/lib/main/assets/flaticons/fzzr.png",   -- optional: the library looks for fzzr.png in the icon folder by itself
    -- IconBase = "https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_ICONS/main/",   -- own icon folder (see README)
    -- TagStyle = { size = 10, height = 16, textDY = -1.5 },                            -- look of the header pills
})

--========================================================================
-- BUILD TAGS (top right of the header) -- edit this block to change them
--========================================================================
-- Which tags this build shows, left to right: any keys from TAG_TYPES, e.g. { "Dev" } / { "Beta", "Priv" } / {} for none.
local BUILD_TAGS = { "Dev" }
-- Define / rename / recolour the kinds of build here (text is what the pill says).
local TAG_TYPES = {
    Beta = { text = "BETA", color = Color3.fromRGB(255, 159, 64) },   -- orange
    Dev  = { text = "DEV",  color = Color3.fromRGB(255, 120, 170) },  -- pink
    Priv = { text = "PRIV", color = Color3.fromRGB(255, 77, 77) },    -- red
}
for _, name in ipairs(BUILD_TAGS) do
    local t = TAG_TYPES[name]
    if t then Window:AddTag(t.text, t.color) end
end

--========================================================================
-- Pages  (category = sidebar heading, parent = makes it a sub page)
--========================================================================
local ragebot  = Window:AddPage("Ragebot",  { category = "Weapon",     icon = "crosshair" })
local legitbot = Window:AddPage("Legitbot", { category = "Weapon",     icon = "brush" })
