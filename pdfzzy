                for i = 1, #kids do
                    local kid = kids[i]
                    local uname = string.match(kid.Name, "^(.*)_%d+$") or kid.Name
                    local rp = kid:GetAttribute("1")
                    print(uname .. " - " .. (type(rp) == "number" and tostring(rp) or "?") .. " reports")
                end
            end)
        end
    end

    ----------------------------------------------------------------------
    -- ITEM ESP (Visuals > Item ESP): dropped items, corpses and corpse loot icons.
    -- Same method as before: the folder is walked once a second in time slices (never one long freeze),
    -- only the nearest N objects are kept, every one keeps its own label slot, positions are exact (no
    -- rounding), text is only rewritten when it changes, and distances use your live position every frame.
    ----------------------------------------------------------------------
    do
        local M_PER_STUD = 0.28          -- game distances: 1 stud = 0.28 m
        local STUDS_PER_M = 1 / M_PER_STUD
        local SLICE, CAP = 0.005, 20000
        local PARTS = { Part = true, MeshPart = true, UnionOperation = true, WedgePart = true, CornerWedgePart = true,
            TrussPart = true, SpawnLocation = true, Seat = true }
        local E = { ent = {}, byAddr = {}, free = {}, nslot = 0, low = {}, junk = {}, pos = {}, no = {}, nh = {}, loot = {},
            scan = 0, act = { item = false, corpse = false, loot = false, at = 0, size = 14, fps = 60, dist = true, hl = true, isz = 26 },
            nextDraw = 0, groups = {}, hidden = {}, lset = {}, gcol = {} }
        FZESP = E
        local WHITE, BLACK_ = { 1, 1, 1 }, { 0, 0, 0 }
        local lowCats = {}
        for n, cs in pairs(FZINV.catOf) do lowCats[n:lower()] = cs end
        for _, g in ipairs(FZESPCFG.groups) do
            local set = {}
            for nm in string.gmatch(g[4], "%S+") do set[nm:lower()] = true end
            E.groups[#E.groups + 1] = { id = g[2], set = set }
        end

        local function findPart(obj, cls)
            if PARTS[cls] then return obj end
            local p = obj:FindFirstChild("Part")
            if p and p.Name ~= "Unreadable_name" and PARTS[p.ClassName] then return p end
            local kids = obj:GetChildren()
            for i = 1, #kids do if PARTS[kids[i].ClassName] then return kids[i] end end
            for i = 1, #kids do
                if kids[i].ClassName == "Model" then
                    local sub = kids[i]:GetChildren()
                    for j = 1, #sub do if PARTS[sub[j].ClassName] then return sub[j] end end
                end
            end
            if cls == "Model" then
                p = obj.PrimaryPart
                if p and p.Name ~= "Unreadable_name" and PARTS[p.ClassName] then return p end
            end
            return nil
        end
        local function hasHum(obj)
            if obj:FindFirstChild("Humanoid") ~= nil then return true end
            local ok, h = pcall(function() return obj:FindFirstChildOfClass("Humanoid") end)
            return ok and h ~= nil
        end
        local function shown(low)
            local cs = lowCats[low]
            if not cs then return false end
            for i = 1, #cs do if not E.hidden[cs[i].name] then return true end end
            return false
        end
        local function pickColor(low)
            for i = 1, #E.groups do
                local g = E.groups[i]
                if E.gcol[g.id] and g.set[low] then return E.gcol[g.id] end
            end
            return nil
        end

        -- walk one folder (max 2 levels of sub folders)
        local function collect(parent, depth, found, origin, st)
            local kids = parent:GetChildren()
            for i = 1, #kids do
                if st.n >= CAP then return end
                st.n = st.n + 1
                local tn = tick()
                if tn - st.t >= SLICE then st.cpu = st.cpu + (tn - st.t); wait(); st.t = tick() end
                local obj = kids[i]
                local nm = obj.Name
                local low = E.low[nm]
                if not low then low = nm:lower(); E.low[nm] = low end
                if shown(low) then
                    if st.items then
                        local addr = obj.Address
                        local c = addr and E.pos[addr]
                        local part, pp
                        if c and c.name == nm and c.seen >= 3 then part, pp = c.part, c.pos
                        else
                            part = findPart(obj, obj.ClassName)
                            pp = part and part.Position
                            if pp and addr then E.pos[addr] = { name = nm, part = part, pos = pp, seen = (c and c.name == nm) and (c.seen + 1) or 1 } end
                        end
                        if pp then
                            local dist = (pp - origin).Magnitude
                            if dist <= st.irange then found[#found + 1] = { wpos = pp, name = nm, dist = dist, col = pickColor(low), addr = addr, hl = E.hlset[nm] } end
                        end
                    end
                elseif not E.junk[nm] then
                    local cls = obj.ClassName
                    if cls == "Folder" then
                        if depth < 2 then collect(obj, depth + 1, found, origin, st) end
                    elseif cls ~= "Model" then
                        E.junk[nm] = true
                    elseif st.corpses then
                        local addr = obj.Address
                        local lastNo = addr and E.no[addr]
                        if not (lastNo and E.scan - lastNo < 120) then
                            local c = addr and E.pos[addr]
                            local isC = c ~= nil and c.corpse == true and c.name == nm
                            if not isC then isC = hasHum(obj) end
                            if isC then
                                local part, pp
                                if c and c.corpse and c.name == nm and c.seen >= 3 then part, pp = c.part, c.pos
                                else
                                    part = findPart(obj, cls)
                                    pp = part and part.Position
                                    if pp and addr then E.pos[addr] = { name = nm, corpse = true, part = part, pos = pp, seen = (c and c.corpse and c.name == nm) and (c.seen + 1) or 1 } end
                                end
                                if pp then
                                    local dist = (pp - origin).Magnitude
                                    if dist <= st.crange then
                                        st.corpses[#st.corpses + 1] = { wpos = pp, name = "[Corpse] " .. nm, dist = dist, col = E.ccol, addr = addr, corpse = true, obj = obj }
                                    end
                                end
                            else
                                if addr then E.no[addr] = E.scan end
                                local k = (E.nh[nm] or 0) + 1
                                E.nh[nm] = k
                                if k >= 3 then E.junk[nm] = true end
                            end
                        end
                    end
                end
            end
        end

        -- items inside a corpse that are on the icon list (Inventory + Character, 4 levels, 150 objects)
        local function readLoot(f, st)
            local addr = f.addr
            local c = addr and E.loot[addr]
            if c and E.scan - c.scan < 6 then f.items = c.names; return end
            if (st.reads or 0) >= 3 then if c then f.items = c.names end return end
            st.reads = (st.reads or 0) + 1
            local names, seen, cnt = {}, {}, 0
            local function walk(parent, depth)
                local kids = parent:GetChildren()
                for i = 1, #kids do
                    if cnt >= 150 then return end
                    cnt = cnt + 1
                    local tn = tick()
                    if tn - st.t >= SLICE then st.cpu = st.cpu + (tn - st.t); wait(); st.t = tick() end
                    local k = kids[i]
                    local nm = k.Name
                    if E.lset[nm] then
                        if not seen[nm] and #names < 4 then seen[nm] = true; names[#names + 1] = nm end
                    elseif depth < 4 then walk(k, depth + 1) end
                end
            end
            local inv = f.obj:FindFirstChild("Inventory")
            if inv then walk(inv, 1) end
            local ch = f.obj:FindFirstChild("Character")
            if ch then walk(ch, 1) end
            if requestImg then for i = 1, #names do requestImg(names[i]) end end
            if addr then E.loot[addr] = { names = names, scan = E.scan } end
            f.items = names
        end

        -- on/off state (switch + key), read at most 5 times a second
        local function refresh(force)
            local A, now = E.act, tick()
            if not force and now - A.at < 0.2 then return A end
            A.at = now
            A.item = Window:IsActive("ie_item") == true
            A.corpse = Window:IsActive("ie_corpse") == true
            A.loot = A.corpse and Window:IsActive("ie_loot") == true
            A.size = Window:Get("ie_size") or 14
            A.fps = Window:Get("ie_fps") or 60
            A.dist = Window:Get("ie_dist") ~= false
            A.isz = Window:Get("ie_isize") or 26
            return A
        end

        local function root()
            local names = { "DroppedItems", "RuntimeItems", "Drops" }
            for i = 1, #names do
                local r = Workspace:FindFirstChild(names[i])
                if r then return r end
            end
            return nil
        end

        task.spawn(function()
            while running do
                local A = refresh(true)
                if Window and Window.ready and (A.item or A.corpse) then
                    while FZLOAD.busy do wait(0.25) end
                    while FZLOCK do wait(0.05) end          -- one heavy scan at a time (SLF and ESP never overlap)
                    FZLOCK = "esp"
                    local ok, err = pcall(function()
                        E.scan = E.scan + 1
                        if E.scan % 300 == 0 then E.junk, E.no, E.nh = {}, {}, {} end
                        -- options for this scan
                        E.hidden = {}
                        local hs = Window:Get("ie_hide")
                        if hs then for k, v in pairs(hs) do if v then E.hidden[k] = true end end end
                        E.gcol = {}
                        for _, g in ipairs(E.groups) do
                            if Window:Get(g.id) == true then
                                local c = Window:GetColor(g.id)
                                if c then E.gcol[g.id] = { c.R, c.G, c.B } end
                            end
                        end
                        E.hlset = (Window:Get("ie_hl") == false) and {} or E.hlAll
                        local cc = Window:GetColor("ie_corpse")
                        E.ccol = cc and { cc.R, cc.G, cc.B } or { 0.75, 0.45, 1 }
                        E.lset = {}
                        local ls = Window:Get("ie_litems")
                        if ls then for k, v in pairs(ls) do if v then E.lset[k] = true end end end
                        local r = root()
                        local hrp = localHrp(tick())
                        local origin = hrp and hrp.Position
                        if not (r and origin) then return end
                        local maxN = Window:Get("ie_max") or 40
                        local st = { n = 0, t = tick(), cpu = 0, items = A.item, irange = (Window:Get("ie_irange") or 140) * STUDS_PER_M,
                            crange = (Window:Get("ie_crange") or 140) * STUDS_PER_M, corpses = A.corpse and {} or nil }
                        E.origin = origin
                        local found = {}
                        collect(r, 1, found, origin, st)
                        table.sort(found, function(a, b) return a.dist < b.dist end)
                        local list = {}
                        for i = 1, math.min(#found, maxN) do list[#list + 1] = found[i] end
                        if st.corpses then
                            table.sort(st.corpses, function(a, b) return a.dist < b.dist end)
                            for i = 1, math.min(#st.corpses, maxN // 2) do
                                local f = st.corpses[i]
                                if A.loot then readLoot(f, st) end
                                list[#list + 1] = f
                            end
                        end
                        -- every object keeps its own slot while it stays in the results
                        local newBy, newList = {}, {}
                        for i = 1, #list do
                            local f = list[i]
                            local e = f.addr and E.byAddr[f.addr]
                            if e then
                                e.wpos, e.dist, e.col, e.hl, e.items = f.wpos, f.dist, f.col, f.hl, f.items
                                e.colSet = nil
                            else
                                e = f
                                e.slot = table.remove(E.free) or (function() E.nslot = E.nslot + 1; return E.nslot end)()
                            end
                            if f.addr then newBy[f.addr] = e end
                            newList[#newList + 1] = e
                        end
                        for addr, e in pairs(E.byAddr) do if not newBy[addr] then E.free[#E.free + 1] = e.slot end end
                        E.byAddr, E.ent = newBy, newList
                        FZP.rec("esp scan cpu", (st.cpu + (tick() - st.t)) * 1000)
                    end)
                    FZLOCK = nil
                    if not ok then warn("[fzzr item esp] " .. tostring(err)) end
                elseif #E.ent > 0 then
                    E.ent, E.byAddr = {}, {}
                end
                wait(Window:Get("ie_every") or 2)
            end
        end)
        E.hlAll = {}
        for n in pairs(HIGHLIGHT) do E.hlAll[n] = true end
        E.hlset = E.hlAll

        local function txtDraw(key, s, x, y, col, size)
            local d = getDrawing(key, "Text")
            local c = d.c
            if c.px == nil or abs(c.px - x) >= 0.05 or abs(c.py - y) >= 0.05 then c.px, c.py = x, y; d.o.Position = Vector2.new(x, y) end
            setProp(d, "Text", s)
            setColor(d, col)
            setProp(d, "Size", size)
            if not c.init then
                c.init = true
                d.o.Font = FONT_BOLD; d.o.Center = true; d.o.Outline = true
                pcall(function() d.o.OutlineColor = Color3.new(0, 0, 0) end)
                d.o.Transparency = 1; d.o.ZIndex = 4
            end
            reveal(d)
        end
        local function imgDraw(key, data, x, y, size)
            local d = getDrawing(key, "Image")
            local c = d.c
            if c.data ~= data then c.data = data; d.o.Data = data end
            if c.sz ~= size then c.sz = size; d.o.Size = Vector2.new(size, size) end
            if c.px == nil or abs(c.px - x) >= 0.05 or abs(c.py - y) >= 0.05 then c.px, c.py = x, y; d.o.Position = Vector2.new(x, y) end
            if not c.init then c.init = true; d.o.Transparency = 1; d.o.ZIndex = 4 end
            reveal(d)
        end

        function E.active() return #E.ent > 0 end
        function E.render(now, dt)
            local A = refresh(false)
            local n = #E.ent
            if n == 0 then return end
            if not (A.item or A.corpse) then return end        -- off: nothing is touched, so the sweep hides every label
            local fps = A.fps
            local skip = false
            if fps < 60 then
                if now < E.nextDraw then skip = true
                else
                    local step = 1 / fps
                    E.nextDraw = E.nextDraw + step
                    if E.nextDraw < now then E.nextDraw = now + step end
                end
            end
            local op = localHrp(now)
            local opos = (op and op.Position) or E.origin
            local size, isz = A.size, A.isz
            local made = 0
            for i = 1, n do
                local e = E.ent[i]
                local want = e.corpse and A.corpse or (not e.corpse and A.item)
                local kt = K("esp", e.slot)
                if want and not pool[kt] then      -- new label objects are created a few per frame, never 40 at once
                    made = made + 1
                    if made > 5 then want = false end
                end
                if want then
                    if skip then
                        if e.vis then
                            getDrawing(kt, "Text")
                            if e.nic then for k = 1, e.nic do getDrawing(K("esi", e.slot, k), "Image") end end
                        end
                    else
                        local pos, onS = WorldToScreen(e.wpos)
                        if onS then
                            e.off = 0
                            e.vis = true
                            local dist = opos and (e.wpos - opos).Magnitude or e.dist
                            local di = floor(dist * M_PER_STUD + 0.5)
                            if e.di ~= di or e.sd ~= A.dist then
                                e.di, e.sd = di, A.dist
                                e.txt = A.dist and (e.name .. " [" .. di .. "m]") or e.name
                            end
                            local col = e.col or ((e.hl and not e.corpse) and HL_COL) or WHITE
                            local px, py = pos.X, pos.Y - 6.5
                            txtDraw(kt, e.txt, px, py, col, size)
                            local nic = 0
                            if A.loot and e.corpse and e.items then
                                local data = IMG.data
                                local list = {}
                                for k = 1, #e.items do local dd = data[e.items[k]]; if dd then list[#list + 1] = dd end end
                                nic = #list
                                local x0 = px - (nic * (isz + 2) - 2) / 2
                                for k = 1, nic do imgDraw(K("esi", e.slot, k), list[k], x0 + (k - 1) * (isz + 2), py + size + 3, isz) end
                            end
                            e.nic = nic
                        else
                            e.off = (e.off or 0) + 1
                            if e.off <= 2 and e.vis then          -- brief grace: keep the last spot instead of blinking
                                getDrawing(kt, "Text")
                                if e.nic then for k = 1, e.nic do getDrawing(K("esi", e.slot, k), "Image") end end
                            else e.vis = false end
                        end
                    end
                end
            end
        end
    end

    ----------------------------------------------------------------------
    -- BOSS TRACKER (Misc > Boss Tracker): looks for the boss names inside the listed Workspace folders
    ----------------------------------------------------------------------
    do
        local BTP = Window:AddPanel("boss", { Title = "Boss Tracker", Width = 190, Side = "Right", OffsetX = 220, Y = 20, Empty = "No bosses selected" })
        local S = { x = nil, y = 20, alpha = 0, drag = nil, wasDown = false, up = {}, rows = {}, base = false, last = -1e9, on = false, folders = {} }
        FZBOSS.s = S
        local W_, ROW = 190, 17
        local function norm(n) return (n:lower():gsub("[%s%-_]", "")) end
        local function folder(path)
            local f = S.folders[path]
            if f and f.Parent then return f end
            f = Workspace
            for part in path:gmatch("[^/]+") do
                f = f:FindFirstChild(part)
                if not f or f.Name == "Unreadable_name" then f = nil break end
            end
            S.folders[path] = f
            return f
        end
        task.spawn(function()
            while running do
                S.on = Window and Window.ready and Window:Get("bt_on") == true
                BTP:Show(S.on)
                if S.on then BTP:SetOpacity((Window:Get("bt_opacity") or 92) / 100); BTP:SetShadow(Window:Get("bt_shadow") ~= false) end
                if S.on and not FZLOAD.busy and tick() - S.last >= (Window:Get("bt_every") or 8) then
                    S.last = tick()
                    local track = Window:Get("bt_track") or {}
                    local found, rows = {}, {}
                    local want = {}
                    for i, nm in ipairs(FZBOSS.names) do want[norm(nm)] = i end
                    for _, path in ipairs(FZBOSS.folders) do
                        local f = folder(path)
                        local ok, kids = pcall(function() return f and f:GetChildren() end)
                        if ok and kids then
                            for i = 1, #kids do
                                local idx = want[norm(kids[i].Name)]
                                if idx then found[idx] = true end
                            end
                        end
                    end
                    for i, nm in ipairs(FZBOSS.names) do
                        if track[nm] then
                            local up = found[i] == true
                            rows[#rows + 1] = { nm, up }
                            local prev = S.up[nm]
                            if S.base and prev ~= nil and prev ~= up and Window:Get("bt_toast") ~= false then
                                pcall(function() Window:Toast({ Title = "Boss Tracker", Text = nm .. (up and " is now available" or " is no longer available"), Icon = "info", Duration = up and 15 or 10 }) end)
                            end
                            S.up[nm] = up
                        end
                    end
                    S.rows, S.base = rows, true
                    local out = {}
                    for i, rw in ipairs(rows) do out[i] = rw[2] and { "! " .. rw[1] .. " !", "good" } or { rw[1], "dim" } end
                    BTP:SetRows(out)
                elseif not S.on then S.base = false; S.up = {} end
                wait(0.5)
            end
        end)
        function FZBOSS.active() return S.on or S.alpha > 0.01 end
        function FZBOSS.render(now, dt) end      -- drawn by the library panel
    end

    local function step()
        local now = tick()
        if _G.__FzzrSession ~= SESSION or not Window.ready then
            readyAt = nil
            P.want, HB.want = false, false; FZINV.hide()
            return 0.25
        end
        readyAt = readyAt or now
        if now - readyAt < 1 then
            P.want, HB.want = false, false; FZINV.hide()
            return 0.25
        end
        local infoOn = Window:Get("pi_on") == true
        local hotOn = Window:Get("hb_on") == true
        local invOn = Window:Get("iv_on") == true
        if not infoOn then P.want = false end
        if not hotOn then HB.want = false end
        if not invOn and FZINV.s.want then FZINV.hide() end
        if FZLOAD.busy then return 0.3 end                      -- load guard: skip the data reads while the PC is struggling
        if not infoOn and not hotOn and not invOn then return 0.3 end      -- both panels off: poll slowly

        -- every option the render hook needs is read here, once per tick
        FZKDR = Window:Get("pi_kdr")
        OPT.perf = Window:Get("perf_mode") == true
        OPT.piOp = (Window:Get("pi_opacity") or 92) / 100
        OPT.piShadow = Window:Get("pi_shadow") ~= false
        OPT.hbOp = (Window:Get("hb_opacity") or 92) / 100
        OPT.hbTile = Window:Get("hb_tile") or 60
        OPT.icons = Window:Get("hb_icons") == true
        OPT.items = Window:Get("hb_items") == true
        OPT.gear = Window:Get("hb_gear") == true
        OPT.stims = Window:Get("hb_stims") == true
        OPT.att = Window:Get("hb_att") == true
        OPT.ivOp = (Window:Get("iv_opacity") or 92) / 100
        OPT.ivShadow = Window:Get("iv_shadow") ~= false

        do local pon = Window:Get("prof_on") == true; if pon and not FZP.on then FZP.d = {}; FZP.t0 = tick() end; FZP.on = pon end
        FZT = FZT or {}
        local function tm(k, t0) FZP.rec("step: " .. k, (tick() - t0) * 1000); FZT[k] = (FZT[k] or 0) + ((tick() - t0) * 1000 - (FZT[k] or 0)) * 0.1 end
        local t0 = tick()
        -- the work is spread over four ticks (look, info, hotbar, inventory) so no single frame pays for all of it
        FZSTAGE = ((FZSTAGE or 0) % 4) + 1
        local stage = FZSTAGE
        localHrp(now)
        if stage == 1 then
            FZLOOK = lookedAt(now, Window:Get("pi_radius") or 150)
            tm("look", t0)
        end
        local look = FZLOOK
        if look then
            lastGrace, lastGraceAt = look, now
        elseif lastGrace and now - lastGraceAt < 1 then
            look = lastGrace                -- the crosshair slipped off for a moment: keep the cards
        end

        if infoOn and stage == 2 then
            t0 = tick()
            stepInfo(now, (Window:Get("pi_target") == "Myself") and LOCAL_NAME or look)
            tm("info", t0)
        end
        if hotOn and stage == 3 then
            t0 = tick()
            stepHot(now, (Window:Get("hb_target") == "Myself") and LOCAL_NAME or look)
            tm("hot", t0)
        end
        if invOn and stage == 4 then
            t0 = tick()
            FZINV.step(now, (Window:Get("iv_target") == "Myself") and LOCAL_NAME or look)
            tm("inv", t0)
        end
        return 0.05
    end

    task.spawn(function()
        while running do
            local t0 = tick()
            local ok, res = pcall(step)
            FZP.rec("step total", (tick() - t0) * 1000)
            stepMs = stepMs + ((tick() - t0) * 1000 - stepMs) * 0.1
            if not ok and res ~= lastErr then lastErr = res; warn("[fzzr player info] " .. tostring(res)) end
            wait((ok and type(res) == "number") and res or 0.1)
        end
    end)

    task.spawn(function()
