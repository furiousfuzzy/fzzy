        "TFZ98S", "CatToken", "ThermalModule", "R700", "338AP", "IOTV4" }) do HIGHLIGHT[n] = true end

    local function newHot(name)
        return { name = name, hot = {}, hotN = 0, eq = {}, eqN = 0, stimIdx = {}, stimN = 0, gc = {},
            statsAt = -1e9, hAt = -1e9, eAt = -1e9 }
    end
    local HD = newHot(nil)

    local function invOf(name)
        local folder = getPlayersFolder()
        local p = folder and folder:FindFirstChild(name)
        return p and p:FindFirstChild("Inventory")
    end

    -- an M4 with ALL of Reapir + PEQ15 + Mag556Rnd100 + SOCOM556 is a GODM4 (icon GODM4.png)
    local function isGodM4(name)
        local inv = invOf(name)
        local m4 = inv and inv:FindFirstChild("M4")
        local atts = m4 and m4:FindFirstChild("Attachments")
        if not atts then return false end
        return atts:FindFirstChild("Reapir") ~= nil and atts:FindFirstChild("PEQ15") ~= nil
            and atts:FindFirstChild("Mag556Rnd100") ~= nil and atts:FindFirstChild("SOCOM556") ~= nil
    end

    -- attachment names found anywhere under Inventory.<gun>.Attachments (nested ones count), in ATT.gun order
    local function gunAtts(name, gun)
        local inv = invOf(name)
        local g = inv and inv:FindFirstChild(gun)
        local atts = g and g:FindFirstChild("Attachments")
        if not atts then return nil end
        local d = atts:GetDescendants()
        local out
        for i = 1, #ATT.gun do
            for j = 1, #d do
                if d[j].Name == ATT.gun[i] then
                    out = out or {}
                    out[#out + 1] = ATT.gun[i]
                    break
                end
            end
        end
        return out
    end

    local function readHotSlots(t, now)
        local wantAtt = OPT.att
        local items, n = t.hot, 0
        local gv = t.gv
        if gv and gv.Parent ~= nil then
            local src = t.hb or gv
            local map = {}
            local kids = src:GetChildren()
            for i = 1, #kids do map[string.lower(kids[i].Name)] = kids[i] end
            local raws = {}
            for i = 1, #HOT_SLOTS do
                local key = HOT_SLOTS[i]
                local item = nameOf(src:GetAttribute(key))
                if not item then
                    local c = map[string.lower(key)]
                    if c then
                        local okv, v = pcall(function() return c.Value end)
                        if okv then item = nameOf(v) end
                        if not item then
                            local inner = c:GetChildren()
                            if #inner > 0 then item = inner[1].Name end
                        end
                    end
                end
                if item then raws[#raws + 1] = item end
            end
            t.held = readItemName(gv, "EquippedTool")

            local used = false
            local list = {}
            for i = 1, #raws do
                local raw = raws[i]
                -- attachment scans are cached per gun for 5 seconds
                local ce = t.gc[raw]
                if not ce or ce.att ~= wantAtt or now - ce.at >= 5 then
                    ce = { at = now, att = wantAtt, god = false, subs = nil }
                    if raw == "M4" and isGodM4(t.name) then ce.god = true
                    elseif wantAtt then ce.subs = gunAtts(t.name, raw) end
                    t.gc[raw] = ce
                end
                local isEq = false
                if not used and t.held ~= nil and raw == t.held then isEq = true; used = true end
                list[#list + 1] = { item = ce.god and "GODM4" or raw, subs = (not ce.god) and ce.subs or nil, eq = isEq }
            end
            t.hot = list
            n = #list
        else
            t.hot = {}
            t.held = nil
        end
        t.hotN = n

        -- stims (attributes on Buffs; the value is only a countdown)
        local sn = 0
        local b = t.buffs
        if b and b.Parent ~= nil and OPT.stims then
            for i = 1, #STIMS do
                local v = b:GetAttribute(STIMS[i].name)
                if v == nil and b:FindFirstChild(STIMS[i].name) then v = true end
                if v ~= nil and v ~= false and v ~= 0 then
                    sn = sn + 1
                    t.stimIdx[sn] = i
                end
            end
        end
        t.stimN = sn
    end

    local function readEquip(t)
        local wantAtt = OPT.att
        local inv = invOf(t.name)
        t.eqFound = inv ~= nil
        local list = {}
        if inv then
            local imap = {}
            local ikids = inv:GetChildren()           -- one read instead of one lookup per gear name
            for i = 1, #ikids do imap[ikids[i].Name] = ikids[i] end
            for i = 1, #ARMOR_ORDER do
                if #list >= 10 then break end
                local gear = ARMOR_ORDER[i]
                local inst = imap[gear]
                if inst then
                    local shown, sub = gear, nil
                    local atts = inst:FindFirstChild("Attachments")
                    if atts then
                        if gear == "FastMT" then
                            local all = true
                            for k = 1, #ATT.fastmt do
                                if not atts:FindFirstChild(ATT.fastmt[k]) then all = false break end
                            end
                            if all then shown = "GMT" end
                        else
                            local vis = ATT.visors[gear]
                            if vis then
                                for v = 1, #vis do
                                    if atts:FindFirstChild(vis[v]) then sub = { vis[v] } break end
                                end
                            end
                        end
                    end
                    local dup = false
                    for k = 1, #list do if list[k].item == shown then dup = true break end end
                    if not dup then list[#list + 1] = { item = shown, subs = wantAtt and sub or nil } end
                end
            end
        end
        t.eq = list
        t.eqN = #list
    end

    -- the first time a player is looked at, everything on screen that has no icon yet is queued for download
    local function requestHotIcons(t)
        for i = 1, t.hotN do
            local it = t.hot[i]
            requestImg(it.item)
            if it.subs then for k = 1, #it.subs do requestImg(it.subs[k]) end end
        end
        for i = 1, t.eqN do
            local it = t.eq[i]
            requestImg(it.item)
            if it.subs then for k = 1, #it.subs do requestImg(it.subs[k]) end end
        end
        for i = 1, t.stimN do requestImg(STIMS[t.stimIdx[i]].name) end
    end

    local function stepHot(now, name)
        HB.want = name ~= nil
        if not name then return end
        if HD.name ~= name then HD = newHot(name) end
        local t = HD
        -- at most one heavy read per call, so a tick never pays for all of them
        if now - t.statsAt >= 2 then t.statsAt = now; resolve(t)
        elseif now - t.hAt >= 0.5 then t.hAt = now; readHotSlots(t, now)
        elseif now - t.eAt >= 3 then t.eAt = now; readEquip(t)
        elseif OPT.icons and now - (t.iAt or 0) >= 1 then t.iAt = now; requestHotIcons(t) end   -- queue check once a second, not every tick
    end

    local function stepInfo(now, name)
        P.want = name ~= nil
        if not name then return end
        if D.name ~= name then
            D = newData(name)
        end
        if now - D.statsAt >= 2 then
            D.statsAt = now
            readStats(D)
        end
        readLive(D, now)

        -- team lookup is only kept up to date while the Team field is on
        TM.want = FIELDS.Team == true
        if TM.want and TM.snap then
            D.team = nil
            for i = 1, #TM.snap do
                if TM.snap[i].set[name] then D.team = TM.snap[i].name break end
            end
        end
    end

    -- one target pick per tick feeds both panels
    -- the panels stay off until the main UI has finished loading (assets in, menu open), plus a short settle time
    local readyAt
    ----------------------------------------------------------------------
    -- INVENTORY panel (Player Display > Inventory): rows read from ReplicatedStorage.Players.<name>.Inventory
    ----------------------------------------------------------------------
    do
    local IVP = Window:AddPanel("inv", { Title = "Inventory", Width = 220, X = 20, Y = 260, Empty = "Nothing to show" })
    local IV = { x = 20, y = 260, h = 80, alpha = 0, want = false, drag = nil, wasDown = false, name = nil, rows = {}, n = 0,
        cache = {}, cacheN = 0 }
    FZINV.s = IV
    local IV_W, IV_ROW, IV_MAXROWS, IV_NODES, IV_DEPTH = 220, 17, 26, 150, 4
    local function isKey(n) return n:lower():find("keychain", 1, true) ~= nil end
    local function ivShown(n)
        local cs = FZINV.catOf[n]
        if not cs then return false end
        for i = 1, #cs do if not FZINV.hide[cs[i].id] then return true end end
        return false
    end
    local function ivCollect(kids, depth, out, st, force)
        for i = 1, #kids do
            if st.n >= IV_NODES then st.cut = true return end
            local c = kids[i]
            if c.ClassName == "Folder" then
                ivCollect(c:GetChildren(), depth, out, st, force)
            else
                st.n = st.n + 1
                local key = isKey(c.Name)
                if not (key and not force and FZINV.hide.keychain) then
                    local sub = c:GetChildren()
                    local show = force or key or ivShown(c.Name)
                    local f2 = force or (key and FZINV.keys)
                    if show then
                        out[#out + 1] = { c.Name, depth, #sub > 0 and depth < IV_DEPTH }
                        if #sub > 0 and depth < IV_DEPTH then
                            local at = #out
                            ivCollect(sub, depth + 1, out, st, f2)
                            if #out == at then out[at][3] = false end
                        end
                    elseif #sub > 0 then
                        ivCollect(sub, depth, out, st, f2)
                    end
                end
            end
        end
    end
    local function ivPush()
        if IV.pushed == IV.rows and IV.pname == IV.name then return end
        IV.pushed, IV.pname = IV.rows, IV.name
        local out = {}
        for i, rw in ipairs(IV.rows) do
            local st = rw[4] and "dim" or (HIGHLIGHT[rw[1]] and "hl") or (rw[3] and "sub") or nil
            out[i] = { rw[1], st, nil, rw[2] * 12 + 4 }
        end
        IVP:SetRows(out, IV.name and fitText(IV.name, 100, 11) or nil)
    end
    function FZINV.hide() IV.want = false; IVP:Show(false) end
    function FZINV.want() return IV.want end
    function FZINV.alpha() return IV.alpha end
    function FZINV.step(now, name)
        IV.want = name ~= nil
        IVP:Show(IV.want)
        IVP:SetOpacity(OPT.ivOp or 0.92); IVP:SetShadow(OPT.ivShadow ~= false)
        if not name then return end
        if name == IV.name and now - (IV.chk or 0) < 0.5 then return end      -- re-check filters at most twice a second
        IV.chk = now
        local sig = ""
        local hs = Window:Get("iv_hide")
        for _, c in ipairs(FZINV.cats) do
            local h = hs and hs[c.name] == true
            FZINV.hide[c.id] = h
            if c.name:lower() == "keychain" then FZINV.hide.keychain = h end
            sig = sig .. (h and "1" or "0")
        end
        FZINV.keys = Window:Get("iv_keys") ~= false
        sig = sig .. (FZINV.keys and "k" or "n")
        IV.name = name
        local e = IV.cache[name]
        if e and e.sig == sig and now - e.at < 8 then IV.rows, IV.n = e.rows, #e.rows; ivPush(); return end
        local rows = {}
        local inv = invOf(name)
        if not inv then
            rows[1] = { "No inventory found", 0, false, true }
        else
            local st = { n = 0 }
            ivCollect(inv:GetChildren(), 0, rows, st, false)
            if st.cut then rows[#rows + 1] = { "...", 0, false, true } end
            if #rows == 0 then rows[1] = { "Nothing to show", 0, false, true } end
        end
        if #rows > IV_MAXROWS then
            local extra = #rows - (IV_MAXROWS - 1)
            for i = #rows, IV_MAXROWS, -1 do rows[i] = nil end
            rows[IV_MAXROWS] = { "+" .. extra .. " more", 0, false, true }
        end
        if IV.cacheN > 12 then IV.cache, IV.cacheN = {}, 0 end
        if not e then IV.cacheN = IV.cacheN + 1 end
        IV.cache[name] = { sig = sig, at = now, rows = rows }
        IV.rows, IV.n = rows, #rows
        ivPush()
    end
    function FZINV.render(now, dt) end      -- drawn by the library panel
    end

    ----------------------------------------------------------------------
    -- SLF: Server Loot Finder panel (Misc > SLF). Counts the picked items anywhere inside every player's Inventory.
    ----------------------------------------------------------------------
    do
        local SLP = Window:AddPanel("slf", { Title = "Server Loot", Width = 210, Side = "Right", Y = 20, Empty = "No loot found" })
        local S = { x = nil, y = 20, h = 60, alpha = 0, want = false, drag = nil, wasDown = false, res = {}, n = 0, rows = {} }
        FZSLF.s = S
        local W_, ROW, MAXR, NODES = 210, 16, 40, 1200
        local function scanOne(name, set)
            local folder = getPlayersFolder()
            local plr = folder and folder:FindFirstChild(name)
            local inv = plr and plr:FindFirstChild("Inventory")
            if not inv then return nil end
            local d = inv:GetDescendants()
            local counts, found = {}, false
            for i = 1, min(#d, NODES) do
                local n = d[i].Name
                if set[n] then counts[n] = (counts[n] or 0) + 1; found = true end
            end
            return found and counts or nil
        end
        task.spawn(function()
            local last = -1e9
            while running do
                local on = Window and Window.ready and Window:Get("slf_on") == true
                S.want = on == true
                SLP:Show(S.want)
                if S.want then SLP:SetOpacity((Window:Get("slf_opacity") or 92) / 100); SLP:SetShadow(Window:Get("slf_shadow") ~= false) end
                if on and tick() - last >= (Window:Get("slf_refresh") or 5) then
                    last = tick()
                    local set = Window:Get("slf_items") or {}
                    local self_ = Window:Get("slf_self") ~= false
                    local folder = getPlayersFolder()
                    local names = {}
                    for _, plr in ipairs(playerList()) do
                        if (self_ or plr.Name ~= LOCAL_NAME) and folder and folder:FindFirstChild(plr.Name) then names[#names + 1] = plr.Name end
                    end
                    table.sort(names)
                    local res = {}
                    for _, nm in ipairs(names) do
                        while FZLOAD.busy do wait(0.25) end
                        while FZLOCK do wait(0.05) end
                        FZLOCK = "slf"
                        local tsc = tick()
                        local ok, c = pcall(scanOne, nm, set)
                        FZLOCK = nil
                        FZP.rec("slf: one player", (tick() - tsc) * 1000)
                        if ok and c then res[#res + 1] = { nm, c } end
                        wait(0.12)
                    end
                    local rows = {}
                    for _, e in ipairs(res) do
                        rows[#rows + 1] = { e[1], 1 }
                        for _, it in ipairs(FZSLF.items) do
                            local c = e[2][it]
                            if c then rows[#rows + 1] = { it .. (c > 1 and (" (" .. c .. "x)") or ""), HIGHLIGHT[it] and 3 or 2 } end
                        end
                    end
                    if #rows == 0 then rows[1] = { "No loot found", 2 } end
                    if #rows > MAXR then
                        local extra = #rows - (MAXR - 1)
                        for i = #rows, MAXR, -1 do rows[i] = nil end
                        rows[MAXR] = { "+" .. extra .. " more", 2 }
                    end
                    S.rows, S.n, S.count = rows, #rows, #res
                    local out = {}
                    for i, rw in ipairs(rows) do out[i] = { rw[1], rw[2] == 1 and "head" or (rw[2] == 3 and "hl" or "sub") } end
                    SLP:SetRows(out, tostring(#res) .. " players")
                end
                wait(0.25)
            end
        end)
        function FZSLF.render(now, dt) end      -- drawn by the library panel
    end

