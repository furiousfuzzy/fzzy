local alerts   = Window:AddPage("Alerts",   { category = "Other",      icon = "bolt" })
local hotbar   = Window:AddPage("Hotbar",    { parent = "Player Display", icon = "grid" })
local pinv     = Window:AddPage("Inventory", { parent = "Player Display", icon = "file" })
local staffdet = Window:AddPage("Staff Detector",   { parent = "Alerts", icon = "user" })
