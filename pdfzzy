-- Profiler: records timings while "Record" is on; Print Report lists them with peaks and heavy parts --
-- Load guard lives in the library: scans check FZLOAD.busy and wait while it is set
-- Panel positions are remembered by the library (fzzr_panels.txt)
FZPOS = { get = function(k) return Window:PosGet(k) end, put = function(k, a, b) Window:PosPut(k, a, b) end }
FZP = { on = false, d = {}, t0 = 0 }
function FZP.rec(k, ms)
    if not FZP.on then return end
    local e = FZP.d[k]
    if not e then e = { n = 0, sum = 0, peak = 0, spk = 0 }; FZP.d[k] = e end
    e.n = e.n + 1; e.sum = e.sum + ms
    if ms > e.peak then e.peak = ms end
    if ms > (k == "frame time" and 33 or 4) then e.spk = e.spk + 1 end
end
function FZP.tp(k, f, a, b)
    local t = tick()
    local ok, e = pcall(f, a, b)
    FZP.rec(k, (tick() - t) * 1000)
    return ok, e
end
function FZP.print()
    local rows = {}
    for k, e in pairs(FZP.d) do rows[#rows + 1] = { k, e } end
    table.sort(rows, function(a, b) return a[2].peak > b[2].peak end)
    local out = { "fzzr profile | recorded " .. string.format("%.0f", tick() - FZP.t0) .. "s" }
    local ft = FZP.d["frame time"]
    if ft and ft.n > 0 then
        out[#out + 1] = string.format("FPS: avg %.0f | lowest %.0f | frames under 30 FPS: %d / %d", 1000 / (ft.sum / ft.n), 1000 / math.max(ft.peak, 1), ft.spk, ft.n)
    end
    out[#out + 1] = "-- part | avg ms | peak ms | calls | spikes over 4 ms --"
    local heavy = {}
    for _, r_ in ipairs(rows) do
        local k, e = r_[1], r_[2]
        if k ~= "frame time" then
            local avg = e.sum / e.n
            local flag = (avg > 1.5 or e.peak > 60) and "  <-- HEAVY" or ""
            if flag ~= "" then heavy[#heavy + 1] = k end
            out[#out + 1] = string.format("%-22s %7.2f %8.2f %7d %6d%s", k, avg, e.peak, e.n, e.spk, flag)
        end
    end
    out[#out + 1] = #heavy > 0 and ("Heavy parts: " .. table.concat(heavy, ", ")) or "Nothing heavy found."
    local text = table.concat(out, "\n")
    for i = 1, #out do print("[profile] " .. out[i]) end
    pcall(function() setclipboard(text) end)
    pcall(function() writefile("fzzr_profile.txt", text) end)
end
