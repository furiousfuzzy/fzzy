        while running do
            if TM.want and (TM.snap == nil or tick() - TM.at >= 30) then
                local snap = {}
                local clans = ReplicatedStorage:FindFirstChild("Clans")
                local okc, teams = pcall(function() return clans and clans:GetChildren() end)
                if okc and teams then
